<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.javafx.csit228capstone.screens.TermsPopupController"
           style="-fx-background-color: rgba(0,0,0,0.4);">

    <VBox prefWidth="640.0" prefHeight="500.0" spacing="0" maxWidth="640" maxHeight="500"
          style="-fx-background-color: white; -fx-background-radius: 16;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 40, 0, 0, 10);">

        <HBox alignment="CENTER_LEFT" spacing="10.0"
              style="-fx-background-color: white; -fx-background-radius: 16 16 0 0;
                     -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0; -fx-padding: 18 24 18 24;">
            <HBox fx:id="backBtn" onMouseClicked="#onBack" alignment="CENTER_LEFT" spacing="6.0"
                  style="-fx-cursor: hand;">
                <ImageView fitHeight="14.0" fitWidth="14.0" preserveRatio="true">
                    <image><Image url="@../../../images/arrow.png" /></image>
                </ImageView>
                <Label text="Go Back" style="-fx-text-fill: #3182CE; -fx-font-size: 13px;" />
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
            <Label text="Terms of Service &amp; Privacy Policy"
                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" />
        </HBox>

        <!-- Scrollable content -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background-color: #F8FAFC; -fx-background: #F8FAFC; -fx-border-color: transparent;">
            <content>
                <VBox spacing="0" style="-fx-background-color: #F8FAFC;">
                    <padding><Insets bottom="30.0" left="28.0" right="28.0" top="24.0" /></padding>

                    <VBox spacing="6.0" style="-fx-background-color: white; -fx-background-radius: 10;
                                               -fx-padding: 18 20 18 20; -fx-border-color: #E2E8F0;
                                               -fx-border-radius: 10; -fx-border-width: 1;">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="1" style="-fx-background-color: #EBF4FF; -fx-text-fill: #3182CE;
                                                   -fx-font-weight: bold; -fx-font-size: 13px;
                                                   -fx-background-radius: 50; -fx-min-width: 28;
                                                   -fx-min-height: 28; -fx-alignment: center;" />
                            <Label text="Purpose of Service"
                                   style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1E293B;" />
                        </HBox>
                        <Label style="-fx-text-fill: #64748B; -fx-font-size: 13px; -fx-padding: 0 0 0 38;"
                               wrapText="true"
                               text="MedServe streamlines public health services, addressing waiting times and missed updates." />
                    </VBox>

                    <Region prefHeight="10" />

                    <VBox spacing="6.0" style="-fx-background-color: white; -fx-background-radius: 10;
                                               -fx-padding: 18 20 18 20; -fx-border-color: #E2E8F0;
                                               -fx-border-radius: 10; -fx-border-width: 1;">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="2" style="-fx-background-color: #EBF4FF; -fx-text-fill: #3182CE;
                                                   -fx-font-weight: bold; -fx-font-size: 13px;
                                                   -fx-background-radius: 50; -fx-min-width: 28;
                                                   -fx-min-height: 28; -fx-alignment: center;" />
                            <Label text="Real-Time Monitoring"
                                   style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1E293B;" />
                        </HBox>
                        <Label style="-fx-text-fill: #64748B; -fx-font-size: 13px; -fx-padding: 0 0 0 38;"
                               wrapText="true"
                               text="Users can monitor queue positions in real-time. This system reduces on-site waiting and improves clinic flow." />
                    </VBox>

                    <Region prefHeight="10" />

                    <VBox spacing="6.0" style="-fx-background-color: white; -fx-background-radius: 10;
                                               -fx-padding: 18 20 18 20; -fx-border-color: #E2E8F0;
                                               -fx-border-radius: 10; -fx-border-width: 1;">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="3" style="-fx-background-color: #EBF4FF; -fx-text-fill: #3182CE;
                                                   -fx-font-weight: bold; -fx-font-size: 13px;
                                                   -fx-background-radius: 50; -fx-min-width: 28;
                                                   -fx-min-height: 28; -fx-alignment: center;" />
                            <Label text="Account Security"
                                   style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1E293B;" />
                        </HBox>
                        <Label style="-fx-text-fill: #64748B; -fx-font-size: 13px; -fx-padding: 0 0 0 38;"
                               wrapText="true"
                               text="You are responsible for managing your account securely, including keeping your password updated regularly." />
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>

        <HBox alignment="CENTER_RIGHT"
              style="-fx-background-color: white; -fx-background-radius: 0 0 16 16;
                     -fx-border-color: #E2E8F0; -fx-border-width: 1 0 0 0; -fx-padding: 16 24 16 24;">
            <Button text="I Understand" onAction="#onBack"
                    style="-fx-background-color: #218AD5; -fx-text-fill: white; -fx-font-weight: bold;
                           -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 10 24 10 24;
                           -fx-cursor: hand;" />
        </HBox>

    </VBox>
</StackPane>