<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<StackPane
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.javafx.csit228capstone.screens.RegisterSuccessController"
        style="-fx-background-color: rgba(0,0,0,0.45);"
        alignment="CENTER">

    <VBox
            alignment="CENTER"
            prefWidth="460.0"
            maxWidth="460.0"
            maxHeight="420.0"
            spacing="0"
            style="
            -fx-background-color: white;
            -fx-background-radius: 20;
            -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.22), 48, 0, 0, 12);
        ">

        <!-- Top accent bar -->
        <HBox
                prefHeight="6"
                style="
                -fx-background-color: linear-gradient(to right, #218AD5, #56b4f0);
                -fx-background-radius: 20 20 0 0;
            " />

        <!-- Body -->
        <VBox alignment="CENTER" spacing="0" style="-fx-padding: 44 40 36 40;">

            <!-- Icon circle -->
            <StackPane style="-fx-padding: 0 0 28 0;">
                <Circle
                        radius="44"
                        style="
                        -fx-fill: #e8f5fe;
                        -fx-stroke: #218AD5;
                        -fx-stroke-width: 2.5;
                    " />
                <Label
                        text="✓"
                        style="
                        -fx-font-size: 38px;
                        -fx-text-fill: #218AD5;
                        -fx-font-weight: bold;
                    " />
            </StackPane>

            <!-- Title -->
            <Label
                    text="Registration Successful!"
                    style="
                    -fx-font-size: 22px;
                    -fx-font-weight: bold;
                    -fx-text-fill: #0F2942;
                    -fx-padding: 0 0 10 0;
                " />

            <!-- Divider -->
            <HBox alignment="CENTER" style="-fx-padding: 0 0 18 0;">
                <Region
                        prefWidth="48"
                        prefHeight="3"
                        style="
                        -fx-background-color: linear-gradient(to right, #218AD5, #56b4f0);
                        -fx-background-radius: 4;
                    " />
            </HBox>

            <!-- Subtitle -->
            <Label
                    text="Your MedServe account is ready."
                    wrapText="true"
                    textAlignment="CENTER"
                    style="
                    -fx-font-size: 14px;
                    -fx-text-fill: #64748B;
                    -fx-padding: 0 0 4 0;
                " />
            <Label
                    text="You can now log in and access all services."
                    wrapText="true"
                    textAlignment="CENTER"
                    style="
                    -fx-font-size: 14px;
                    -fx-text-fill: #64748B;
                    -fx-padding: 0 0 36 0;
                " />

            <!-- Continue Button -->
            <Button
                    fx:id="continueBtn"
                    text="Go to Login"
                    onAction="#onContinue"
                    prefWidth="320"
                    prefHeight="46"
                    style="
                    -fx-background-color: linear-gradient(to right, #218AD5, #2fa8f0);
                    -fx-text-fill: white;
                    -fx-font-size: 14px;
                    -fx-font-weight: bold;
                    -fx-background-radius: 10;
                    -fx-cursor: hand;
                    -fx-effect: dropshadow(gaussian, rgba(33,138,213,0.30), 12, 0, 0, 4);
                " />

        </VBox>

        <!-- Footer -->
        <HBox alignment="CENTER" style="-fx-padding: 0 0 20 0;">
            <Label
                    text="MedServe · Secure Health Platform"
                    style="
                    -fx-font-size: 11px;
                    -fx-text-fill: #CBD5E1;
                " />
        </HBox>

    </VBox>
</StackPane>