<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="root" maxWidth="300.0" minWidth="300.0" prefWidth="300.0"
      styleClass="menu-pane" VBox.vgrow="ALWAYS"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.javafx.csit228capstone.screens.admin.AdminMenuController">
    <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
    <children>

        <!-- Logo -->
        <HBox alignment="CENTER" prefHeight="63.0" prefWidth="260.0">
            <children>
                <Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
                      prefHeight="40.0" prefWidth="40.0" styleClass="logo" />
                <Label alignment="CENTER" prefHeight="47.0" prefWidth="135.0"
                       styleClass="medserve" text="MedServe">
                    <font><Font name="SansSerif Regular" size="24.0" /></font>
                </Label>
            </children>
        </HBox>

        <!-- Profile -->
        <HBox fx:id="profileBtn" alignment="CENTER" prefHeight="32.0" prefWidth="240.0" styleClass="profile-pane">
            <children>
                <Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
                      prefHeight="45.0" prefWidth="45.0" styleClass="profile-icon" />
                <VBox alignment="CENTER" prefHeight="64.0" prefWidth="176.0">
                    <children>
                        <Label fx:id="nameLabel" text="Admin">
                            <font><Font name="System Bold" size="16.0" /></font>
                        </Label>
                        <Label text="Administrator" />
                    </children>
                </VBox>
            </children>
            <VBox.margin><Insets bottom="10.0" top="20.0" /></VBox.margin>
            <padding><Insets bottom="10.0" top="10.0" /></padding>
        </HBox>

        <Separator prefWidth="200.0" />

        <!-- Menu Label -->
        <Label styleClass="mainmenu-label" text="MAIN MENU">
            <font><Font size="14.0" /></font>
            <VBox.margin><Insets top="20.0" /></VBox.margin>
        </Label>

        <!-- Dashboard -->
        <Button fx:id="dashboardBtn" alignment="TOP_LEFT" mnemonicParsing="false"
                prefHeight="31.0" prefWidth="301.0" styleClass="mainmenu-button" text="Dashboard">
            <VBox.margin><Insets top="10.0" /></VBox.margin>
            <padding><Insets bottom="9.0" left="14.0" right="14.0" top="9.0" /></padding>
            <font><Font size="14.0" /></font>
            <graphic>
                <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                    <image><Image url="@../../../../images/icon_menu.png" /></image>
                </ImageView>
            </graphic>
        </Button>

        <!-- Live Queue -->
        <Button fx:id="liveQueueBtn" alignment="TOP_LEFT" mnemonicParsing="false"
                prefHeight="31.0" prefWidth="301.0" styleClass="mainmenu-button" text="Live Queue">
            <VBox.margin><Insets top="10.0" /></VBox.margin>
            <padding><Insets bottom="9.0" left="14.0" right="14.0" top="9.0" /></padding>
            <font><Font size="14.0" /></font>
            <graphic>
                <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                    <image><Image url="@../../../../images/queue.png" /></image>
                </ImageView>
            </graphic>
        </Button>

        <!-- Manage Queue -->
        <Button fx:id="manageQueueBtn" alignment="TOP_LEFT" mnemonicParsing="false"
                prefHeight="31.0" prefWidth="301.0" styleClass="mainmenu-button" text="Manage Queue">
            <VBox.margin><Insets top="10.0" /></VBox.margin>
            <padding><Insets bottom="9.0" left="14.0" right="14.0" top="9.0" /></padding>
            <font><Font size="14.0" /></font>
            <graphic>
                <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                    <image><Image url="@../../../../images/queue.png" /></image>
                </ImageView>
            </graphic>
        </Button>

        <!-- Manage Users -->
        <Button fx:id="manageUsersBtn" alignment="TOP_LEFT" mnemonicParsing="false"
                prefHeight="31.0" prefWidth="301.0" styleClass="mainmenu-button" text="Manage Users">
            <VBox.margin><Insets top="10.0" /></VBox.margin>
            <padding><Insets bottom="9.0" left="14.0" right="14.0" top="9.0" /></padding>
            <font><Font size="14.0" /></font>
            <graphic>
                <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                    <image><Image url="@../../../../images/user.png" /></image>
                </ImageView>
            </graphic>
        </Button>

        <!-- Manage Schedule -->
        <Button fx:id="manageScheduleBtn" alignment="TOP_LEFT" mnemonicParsing="false"
                prefHeight="31.0" prefWidth="301.0" styleClass="mainmenu-button" text="Manage Schedule">
            <VBox.margin><Insets top="10.0" /></VBox.margin>
            <padding><Insets bottom="9.0" left="14.0" right="14.0" top="9.0" /></padding>
            <font><Font size="14.0" /></font>
            <graphic>
                <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                    <image><Image url="@../../../../images/calendar_black.png" /></image>
                </ImageView>
            </graphic>
        </Button>

        <!-- Spacer pushes logout to bottom -->
        <HBox fx:id="logoutBtn" alignment="CENTER_LEFT" prefHeight="35.0"
              prefWidth="260.0" styleClass="logout">
            <VBox.margin><Insets top="180.0" left="15.0"/></VBox.margin>
            <children>
                <Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
                      prefHeight="20.0" prefWidth="20.0" styleClass="logout-icon">
                    <HBox.margin><Insets right="10.0" /></HBox.margin>
                </Pane>
                <Label text="Log out">
                    <font><Font name="System" size="12.0" /></font>
                </Label>
            </children>
        </HBox>

    </children>
</VBox>