<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import java.lang.String?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javafx.csit228capstone.screens.admin.AdminScheduleController" styleClass="main-pane">

    <stylesheets>
        <String fx:value="/styles/schedule.css"/>
    </stylesheets>

    <left>
        <fx:include fx:id="menu" source="admin_menu_pane.fxml" />
    </left>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="scroll-pane">
            <content>
                <VBox fx:id="scheduleScreen" spacing="24.0" styleClass="content-root">
                    <padding>
                        <Insets bottom="30.0" left="35.0" right="20.0" top="30.0" />
                    </padding>
                    <children>

                        <HBox alignment="CENTER_LEFT" prefHeight="71.0">
                            <children>
                                <VBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label fx:id="screenLabel" styleClass="screen-label" text="Manage Schedule">
                                            <font>
                                                <Font size="24.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <VBox alignment="CENTER_RIGHT">
                                    <children>
                                        <Label style="-fx-text-fill: #64748B; -fx-font-size: 14px;" text="Today" />
                                        <Label fx:id="selectedDateLabel" style="-fx-font-weight: bold; -fx-font-size: 16px;" text="" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                            <children>

                                <VBox styleClass="schedule-panel" HBox.hgrow="ALWAYS" spacing="0">
                                    <children>
                                        <ScrollPane fx:id="scheduleScrollPane" styleClass="schedule-scroll" fitToWidth="true" fitToHeight="true" VBox.vgrow="ALWAYS" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                                            <content>
                                                <VBox fx:id="timeSlotsContainer" styleClass="slots-container"/>
                                            </content>
                                        </ScrollPane>
                                    </children>
                                </VBox>

                                <VBox styleClass="calendar-panel" minWidth="340.0" maxWidth="380.0" spacing="0">
                                    <children>
                                        <HBox styleClass="calendar-nav" alignment="CENTER" spacing="0">
                                            <children>
                                                <Button fx:id="prevMonthButton" styleClass="cal-arrow-button" text="&#8249;"/>
                                                <Label fx:id="monthYearLabel" styleClass="month-year-label" HBox.hgrow="ALWAYS" alignment="CENTER" maxWidth="Infinity"/>
                                                <Button fx:id="nextMonthButton" styleClass="cal-arrow-button" text="&#8250;"/>
                                            </children>
                                        </HBox>

                                        <GridPane styleClass="cal-days-panel" hgap="4.0" vgap="4.0">
                                            <columnConstraints>
                                                <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                                                <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                                                <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                                                <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                                                <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                                                <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                                                <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                                            </columnConstraints>
                                            <children>
                                                <Label text="Su" styleClass="cal-day-label" GridPane.columnIndex="0" GridPane.rowIndex="0" maxWidth="Infinity" alignment="CENTER"/>
                                                <Label text="Mo" styleClass="cal-day-label" GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="Infinity" alignment="CENTER"/>
                                                <Label text="Tu" styleClass="cal-day-label" GridPane.columnIndex="2" GridPane.rowIndex="0" maxWidth="Infinity" alignment="CENTER"/>
                                                <Label text="We" styleClass="cal-day-label" GridPane.columnIndex="3" GridPane.rowIndex="0" maxWidth="Infinity" alignment="CENTER"/>
                                                <Label text="Th" styleClass="cal-day-label" GridPane.columnIndex="4" GridPane.rowIndex="0" maxWidth="Infinity" alignment="CENTER"/>
                                                <Label text="Fr" styleClass="cal-day-label" GridPane.columnIndex="5" GridPane.rowIndex="0" maxWidth="Infinity" alignment="CENTER"/>
                                                <Label text="Sa" styleClass="cal-day-label" GridPane.columnIndex="6" GridPane.rowIndex="0" maxWidth="Infinity" alignment="CENTER"/>
                                            </children>
                                        </GridPane>

                                        <GridPane fx:id="calendarGrid" styleClass="cal-grid" hgap="4.0" vgap="4.0" VBox.vgrow="NEVER">
                                            <columnConstraints>
                                                <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                                                <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                                                <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                                                <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                                                <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                                                <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                                                <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                                            </columnConstraints>
                                        </GridPane>

                                        <VBox fx:id="legendBox" styleClass="legend-box" spacing="8.0">
                                            <padding>
                                                <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                                            </padding>
                                            <children>
                                                <Label styleClass="legend-title" text="Categories"/>
                                                <HBox spacing="8.0" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Circle radius="6.0" styleClass="dot,dot-blue"/>
                                                        <Label text="General Wellness" styleClass="legend-label"/>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="8.0" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Circle radius="6.0" styleClass="dot,dot-pink"/>
                                                        <Label text="Women's Health" styleClass="legend-label"/>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="8.0" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Circle radius="6.0" styleClass="dot,dot-green"/>
                                                        <Label text="Specialized Fields" styleClass="legend-label"/>
                                                    </children>
                                                </HBox>
                                                <HBox spacing="8.0" alignment="CENTER_LEFT">
                                                    <children>
                                                        <Circle radius="6.0" styleClass="dot,dot-purple"/>
                                                        <Label text="Diagnostics &amp; Lab" styleClass="legend-label"/>
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>