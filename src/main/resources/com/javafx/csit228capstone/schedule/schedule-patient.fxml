<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javafx.csit228capstone.screens.schedule.SchedulePatientController">
    <left>
        <fx:include fx:id="menu" source="../menu-pane.fxml" />
    </left>
    <center>
        <VBox fillWidth="true" styleClass="main-pane" BorderPane.alignment="CENTER">
            <children>

                <HBox alignment="CENTER" prefHeight="71.0">
                    <children>
                        <Label fx:id="screenLabel" styleClass="screen-label" text="Schedule">
                            <font>
                                <Font size="24.0" />
                            </font>
                     <HBox.margin>
                        <Insets top="20.0" />
                     </HBox.margin>
                        </Label>
                        <Region maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                        <Pane fx:id="notification" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="33.0" prefWidth="32.0" styleClass="notification-icon">
                     <HBox.margin>
                        <Insets top="20.0" />
                     </HBox.margin></Pane>
                    </children>
                </HBox>

                <!-- Section title -->
                <Label fx:id="scheduleLabel">
                    <font><Font name="System Bold" size="18.0" /></font>
                    <VBox.margin><Insets bottom="10.0" /></VBox.margin>
                </Label>

                <!-- Search bar -->
                <HBox alignment="CENTER" prefHeight="37.0" prefWidth="485.0" spacing="0.0" styleClass="search-bar">
                    <children>
                        <TextField fx:id="searchField" maxWidth="1.7976931348623157E308" prefHeight="37.0" prefWidth="453.0" promptText="" styleClass="search-field" HBox.hgrow="ALWAYS" />
                        <Button fx:id="searchButton" mnemonicParsing="false" prefHeight="36.0" prefWidth="35.0" styleClass="search-button">
                            <graphic>
                                <ImageView fitHeight="30.0" fitWidth="26.0" pickOnBounds="true" preserveRatio="true">
                                    <image>
                                        <Image url="@../../../../images/magnifying-glass.png" />
                                    </image>
                                    <rotationAxis>
                                        <Point3D />
                                    </rotationAxis>
                                </ImageView>
                            </graphic>
                            <rotationAxis>
                                <Point3D />
                            </rotationAxis>
                            <HBox.margin>
                                <Insets bottom="1.0" />
                            </HBox.margin>
                        </Button>
                    </children>
                    <VBox.margin><Insets bottom="12.0" /></VBox.margin>
                </HBox>
                <HBox alignment="CENTER_LEFT" prefHeight="36.0" prefWidth="594.0" spacing="10.0">
                    <children>
                        <Label styleClass="lbl-category, lbl-general-wellness" text="General Wellness" />
                        <Label styleClass="lbl-category, lbl-womens-health" text="Women's Health" />
                        <Label styleClass="lbl-category, lbl-specialized" text="Specialized Fields" />
                        <Label styleClass="lbl-category, lbl-diagnostics" text="Labs &amp; Diagnostics" />
                    </children>
                    <VBox.margin>
                        <Insets bottom="15.0" />
                    </VBox.margin>
                </HBox>

                <!-- Main content: schedule list + calendar -->
                <HBox spacing="14.0" VBox.vgrow="ALWAYS">
                    <children>

                        <!-- Schedule time slots panel -->
                        <VBox styleClass="schedule-panel" HBox.hgrow="ALWAYS">
                            <children>
                                <Label fx:id="selectedDateLabel" alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="schedule-date-header" text="Saturday, April 11">
                                    <font><Font size="12.0" /></font>
                                    <VBox.margin>
                                        <Insets />
                                    </VBox.margin>
                                    <padding>
                                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                    </padding>
                                </Label>
                                <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" styleClass="full-service-panel" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                                    <content>
                                        <VBox fx:id="timeSlotsContainer" spacing="0.0" styleClass="services-panel">
                                            <padding><Insets top="10.0" /></padding>
                                        </VBox>
                                    </content>
                                </ScrollPane>
                            </children>
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                        </VBox>

                        <!-- Calendar panel -->
                        <VBox prefWidth="330.0" spacing="0.0" styleClass="calendar-panel">
                            <children>

                                <!-- Month navigation -->
                                <HBox alignment="CENTER" spacing="10.0" styleClass="calendar-nav">
                                    <children>
                                        <Button fx:id="prevMonthButton" mnemonicParsing="false" styleClass="cal-arrow-button" text="⮜">
                                            <font>
                                                <Font size="18.0" />
                                            </font></Button>
                                        <Label fx:id="monthYearLabel" alignment="CENTER" maxWidth="1.7976931348623157E308" text="April 2026" HBox.hgrow="ALWAYS">
                                            <font><Font name="System Bold" size="13.0" /></font>
                                        </Label>
                                        <Button fx:id="nextMonthButton" mnemonicParsing="false" styleClass="cal-arrow-button" text="⮞">
                                            <font>
                                                <Font size="18.0" />
                                            </font></Button>
                                    </children>
                                    <VBox.margin>
                                        <Insets />
                                    </VBox.margin>
                                    <padding>
                                        <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
                                    </padding>
                                </HBox>

                                <!-- Day-of-week headers -->
                                <GridPane hgap="2.0" styleClass="day-panel" vgap="2.0">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="20.0" vgrow="SOMETIMES" />
                                    </rowConstraints>
                                    <children>
                                        <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="cal-day-label" text="Su" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                        <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="cal-day-label" text="Mo" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                        <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="cal-day-label" text="Tu" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                                        <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="cal-day-label" text="We" GridPane.columnIndex="3" GridPane.rowIndex="0">
                                            <GridPane.margin>
                                                <Insets />
                                            </GridPane.margin></Label>
                                        <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="cal-day-label" text="Th" GridPane.columnIndex="4" GridPane.rowIndex="0" />
                                        <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="cal-day-label" text="Fr" GridPane.columnIndex="5" GridPane.rowIndex="0" />
                                        <Label alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="cal-day-label" text="Sa" GridPane.columnIndex="6" GridPane.rowIndex="0" />
                                    </children>
                                    <padding><Insets left="10.0" right="10.0" top="10.0" /></padding>
                                </GridPane>

                                <!-- Calendar day cells (populated by controller) -->
                                <GridPane fx:id="calendarGrid" hgap="8.0" styleClass="cal-days-panel" vgap="8.0" VBox.vgrow="ALWAYS">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                                    </columnConstraints>
                                    <padding><Insets bottom="20.0" left="10.0" right="10.0" top="4.0" /></padding>
                                </GridPane>
                                <Region prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS" />

                            </children>
                        </VBox>

                    </children>
                </HBox>

            </children>
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
        </VBox>
    </center>
</BorderPane>
