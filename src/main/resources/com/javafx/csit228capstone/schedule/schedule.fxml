<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javafx.csit228capstone.screens.schedule.ScheduleController" styleClass="main-pane">

    <left>
        <fx:include fx:id="menu" source="../menu-pane.fxml"/>
    </left>

    <center>
        <VBox styleClass="content-root" spacing="0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="30.0" left="35.0" right="20.0" top="30.0" />
            </padding>
            <children>

                <HBox alignment="CENTER" maxHeight="-Infinity" minHeight="-Infinity" prefHeight="71.0">
                    <children>
                        <Label fx:id="screenLabel" styleClass="screen-label" text="Schedule">
                            <font>
                                <Font size="24.0" />
                            </font>
                        </Label>
                        <Region maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                        <Pane fx:id="notification" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="33.0" prefWidth="32.0" styleClass="notification-icon" />
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" prefHeight="37.0" spacing="0.0" styleClass="search-bar">
                    <VBox.margin>
                        <Insets bottom="12.0" />
                    </VBox.margin>
                    <children>
                        <TextField fx:id="searchField" promptText="Search services..." maxWidth="1.7976931348623157E308" prefHeight="37.0" styleClass="search-field" HBox.hgrow="ALWAYS">
                            <HBox.margin>
                                <Insets left="14.0" />
                            </HBox.margin>
                        </TextField>
                        <Button mnemonicParsing="false" styleClass="search-button">
                            <graphic>
                                <SVGPath content="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" fill="#218AD5" />
                            </graphic>
                        </Button>
                    </children>
                </HBox>

                <HBox fx:id="categoryFilterBar" styleClass="category-filter-bar" spacing="10" alignment="CENTER_LEFT">
                    <VBox.margin>
                        <Insets bottom="12.0" left="0.0" right="0.0" top="4.0" />
                    </VBox.margin>
                    <padding>
                        <Insets top="0" right="0" bottom="0" left="0"/>
                    </padding>
                    <children>
                        <Button fx:id="btnGeneralWellness" text="General Wellness" styleClass="filter-btn,filter-btn-blue" onAction="#onClickBtnGeneralWellness"/>
                        <Button fx:id="btnWomensHealth" text="Women's Health" styleClass="filter-btn,filter-btn-pink" onAction="#onClickBtnWomensHealth"/>
                        <Button fx:id="btnSpecializedFields" text="Specialized Fields" styleClass="filter-btn,filter-btn-green" onAction="#onClickBtnSpecializedFields"/>
                        <Button fx:id="btnDiagnosticsLab" text="Diagnostics &amp; Lab" styleClass="filter-btn,filter-btn-purple" onAction="#onClickBtnDiagnosticsLab"/>
                    </children>
                </HBox>

                <HBox spacing="16" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets top="0" right="0" bottom="0" left="0"/>
                    </padding>

                    <VBox styleClass="schedule-panel" HBox.hgrow="ALWAYS" spacing="0">

                        <HBox styleClass="date-header-bar" alignment="CENTER_LEFT" spacing="8">
                            <Label fx:id="selectedDateLabel" styleClass="schedule-date-header" text=""/>
                        </HBox>

                        <ScrollPane fx:id="scheduleScrollPane" styleClass="schedule-scroll" fitToWidth="true" VBox.vgrow="ALWAYS" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                            <VBox fx:id="timeSlotsContainer" styleClass="slots-container"/>
                        </ScrollPane>

                    </VBox>

                    <VBox styleClass="calendar-panel" minWidth="280" maxWidth="300" spacing="0">

                        <HBox styleClass="calendar-nav" alignment="CENTER" spacing="0">
                            <Button fx:id="prevMonthButton" styleClass="cal-arrow-button" text="&#8249;"/>
                            <Label fx:id="monthYearLabel" styleClass="month-year-label" HBox.hgrow="ALWAYS" alignment="CENTER" maxWidth="Infinity"/>
                            <Button fx:id="nextMonthButton" styleClass="cal-arrow-button" text="&#8250;"/>
                        </HBox>

                        <GridPane styleClass="cal-days-panel" hgap="4" vgap="4">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                                <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                                <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                                <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                                <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                                <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                                <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                            </columnConstraints>
                            <Label text="Su" styleClass="cal-day-label" GridPane.columnIndex="0" GridPane.rowIndex="0" maxWidth="Infinity" alignment="CENTER"/>
                            <Label text="Mo" styleClass="cal-day-label" GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="Infinity" alignment="CENTER"/>
                            <Label text="Tu" styleClass="cal-day-label" GridPane.columnIndex="2" GridPane.rowIndex="0" maxWidth="Infinity" alignment="CENTER"/>
                            <Label text="We" styleClass="cal-day-label" GridPane.columnIndex="3" GridPane.rowIndex="0" maxWidth="Infinity" alignment="CENTER"/>
                            <Label text="Th" styleClass="cal-day-label" GridPane.columnIndex="4" GridPane.rowIndex="0" maxWidth="Infinity" alignment="CENTER"/>
                            <Label text="Fr" styleClass="cal-day-label" GridPane.columnIndex="5" GridPane.rowIndex="0" maxWidth="Infinity" alignment="CENTER"/>
                            <Label text="Sa" styleClass="cal-day-label" GridPane.columnIndex="6" GridPane.rowIndex="0" maxWidth="Infinity" alignment="CENTER"/>
                        </GridPane>

                        <GridPane fx:id="calendarGrid" styleClass="cal-grid" hgap="4" vgap="4" VBox.vgrow="NEVER">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                                <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                                <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                                <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                                <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                                <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                                <ColumnConstraints percentWidth="14.28" halignment="CENTER"/>
                            </columnConstraints>
                        </GridPane>

                        <VBox fx:id="legendBox" styleClass="legend-box" spacing="6">
                            <padding>
                                <Insets top="16" right="16" bottom="16" left="16"/>
                            </padding>
                            <Label styleClass="legend-title" text="Categories"/>
                            <HBox spacing="6" alignment="CENTER_LEFT">
                                <Circle radius="5" styleClass="dot,dot-blue"/>
                                <Label text="General Wellness" styleClass="legend-label"/>
                            </HBox>
                            <HBox spacing="6" alignment="CENTER_LEFT">
                                <Circle radius="5" styleClass="dot,dot-pink"/>
                                <Label text="Women's Health" styleClass="legend-label"/>
                            </HBox>
                            <HBox spacing="6" alignment="CENTER_LEFT">
                                <Circle radius="5" styleClass="dot,dot-green"/>
                                <Label text="Specialized Fields" styleClass="legend-label"/>
                            </HBox>
                            <HBox spacing="6" alignment="CENTER_LEFT">
                                <Circle radius="5" styleClass="dot,dot-purple"/>
                                <Label text="Diagnostics &amp; Lab" styleClass="legend-label"/>
                            </HBox>
                        </VBox>

                    </VBox>
                </HBox>

            </children>
        </VBox>
    </center>

</BorderPane>