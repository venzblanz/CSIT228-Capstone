                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                     <children>
                        <HBox fx:id="gwBtn" alignment="CENTER_LEFT" maxHeight="170.0" minHeight="170.0" styleClass="gw-card">
                           <children>
                                          <Pane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" prefHeight="170.0" prefWidth="6.0" styleClass="gw-color-bar">
