                                    <Insets />
                                 </HBox.margin>
                              </Pane>
                              <StackPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="70.0" prefWidth="70.0" styleClass="gw-icon-circle">
