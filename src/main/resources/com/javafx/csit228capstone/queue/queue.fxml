                                 </HBox.margin>
                              </StackPane>
                              <VBox alignment="CENTER_LEFT" prefHeight="200.0" prefWidth="100.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="wh-label" text="Women's Health" />
                                    <Label layoutX="10.0" layoutY="10.0" styleClass="gw-text" text="Care tailored for women's wellness. Prenatal Checkups, Postnatal, Breast, and Menstrual concerns and more" wrapText="true" />
                                 </children>
                                 <HBox.margin>
                                    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
