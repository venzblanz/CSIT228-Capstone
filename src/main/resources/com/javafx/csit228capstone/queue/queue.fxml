<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javafx.csit228capstone.screens.queue.QueueController">
    <left>
        <fx:include fx:id="menu" source="../menu-pane.fxml" />
    </left>
    <center>
      <ScrollPane fitToWidth="true" vbarPolicy="ALWAYS" BorderPane.alignment="CENTER">
         <content>
              <VBox fx:id="queueScreen" fillWidth="true" maxWidth="1.7976931348623157E308" styleClass="main-pane">
                  <children>
      
                      <HBox alignment="CENTER" prefHeight="71.0">
                          <children>
                              <Label fx:id="screenLabel" styleClass="screen-label" text="Queue">
                                  <font>
                              <Font size="24.0" />
                           </font>
                              </Label>
                              <Region maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                              <Pane fx:id="notification" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="33.0" prefWidth="32.0" styleClass="notification-icon" />
                          </children>
                      </HBox>
      
                      <VBox fx:id="headerMessage" alignment="CENTER_LEFT">
