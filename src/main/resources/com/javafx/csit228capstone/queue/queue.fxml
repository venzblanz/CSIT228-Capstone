                              </Label>
                              <Label styleClass="recent" text="Choose a department to get started">
                                  <font>
                              <Font size="18.0" />
                           </font>
                              </Label>
                          </children>
                          <VBox.margin>
                        <Insets bottom="10.0" top="10.0" />
                     </VBox.margin>
                      </VBox>
                  <GridPane hgap="20.0" maxHeight="350.0" minHeight="340.0" vgap="20.0" VBox.vgrow="ALWAYS">
