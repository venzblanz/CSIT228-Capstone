                              <Region maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                              <Label fx:id="seeAllBtn" styleClass="see-all" text="See All">
                                  <font>
                              <Font size="14.0" />
                           </font>
                              </Label>
                          </children>
                      </HBox>
                  <VBox fx:id="activeQueueContainer" alignment="CENTER" spacing="10.0">
                     <VBox.margin>
                        <Insets bottom="10.0" top="10.0" />
                     </VBox.margin>
                  </VBox>
      
                  </children>
                  <padding>
                      <Insets bottom="30.0" left="35.0" right="20.0" top="30.0" />
                  </padding>
