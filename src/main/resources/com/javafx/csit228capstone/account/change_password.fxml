<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="800.0" prefWidth="1280.0"
            stylesheets="@../../../../styles/account-edit.css,@../../../../styles/menu-pane.css"
            xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.javafx.csit228capstone.screens.Account.ChangePasswordController">

    <left>
        <fx:include fx:id="menu" source="../menu-pane.fxml" />
    </left>

    <center>
        <VBox styleClass="main-content">
            <children>

                <HBox alignment="CENTER_LEFT" styleClass="top-bar">
                    <children>
                        <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 24px; -fx-font-weight: normal; -fx-text-fill: #1E293B;"
                               text="Change Password" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="notifBtn" mnemonicParsing="false" styleClass="notif-btn">
                            <graphic>
                                <ImageView fitHeight="24.0" fitWidth="24.0" preserveRatio="true">
                                    <image><Image url="@../../../../images/notification_icon.png" /></image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </children>
                    <VBox.margin><Insets top="30.0" /></VBox.margin>
                </HBox>

                <VBox alignment="CENTER" VBox.vgrow="ALWAYS">
                    <children>
                        <VBox maxWidth="420.0" spacing="30.0">
                            <children>


                                <VBox alignment="CENTER" spacing="12.0">
                                    <children>
                                        <ImageView fitHeight="64.0" fitWidth="64.0" preserveRatio="true">
                                            <image><Image url="@../../../../images/Security.png" /></image>
                                        </ImageView>
                                        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Update Your Password" />
                                        <Label style="-fx-text-fill: #64748B; -fx-text-alignment: center; -fx-font-size: 13px;"
                                               text="Please enter your current password to confirm it's you, then choose a new strong password."
                                               wrapText="true" />
                                    </children>
                                </VBox>
                                <VBox spacing="18.0">
                                    <children>
                                        <VBox spacing="6.0">
                                            <children>
                                                <Label styleClass="field-label" text="Current Password" />
                                                <PasswordField fx:id="currentPasswordField" prefHeight="45.0"
                                                               promptText=" " styleClass="field-input" />
                                            </children>
                                        </VBox>

                                        <Separator opacity="0.5" />

                                        <VBox spacing="6.0">
                                            <children>
                                                <Label styleClass="field-label" text="New Password" />
                                                <PasswordField fx:id="newPasswordField" prefHeight="45.0"
                                                               promptText="Minimum 8 characters" styleClass="field-input" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="6.0">
                                            <children>
                                                <Label styleClass="field-label" text="Confirm New Password" />
                                                <PasswordField fx:id="confirmNewPasswordField" prefHeight="45.0"
                                                               promptText="Repeat your new password" styleClass="field-input" />
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>

                                <VBox spacing="12.0">
                                    <children>
                                        <Button fx:id="saveBtn" maxWidth="Infinity" prefHeight="45.0"
                                                styleClass="update-btn" text="Save Changes" />
                                        <Button fx:id="cancelBtn" maxWidth="Infinity" prefHeight="40.0"
                                                style="-fx-background-color: transparent; -fx-text-fill: #64748B; -fx-cursor: hand;"
                                                text="Cancel and Go Back" />
                                    </children>
                                    <VBox.margin><Insets top="10.0" /></VBox.margin>
                                </VBox>

                            </children>
                        </VBox>
                    </children>
                </VBox>

            </children>
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" />
            </padding>
        </VBox>
    </center>
</BorderPane>