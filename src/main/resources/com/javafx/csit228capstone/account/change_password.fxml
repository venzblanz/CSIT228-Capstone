<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="1280.0" styleClass="main-pane" stylesheets="@../../../../styles/dashboard.css,@../../../../styles/account-edit.css,@../../../../styles/menu-pane.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javafx.csit228capstone.screens.Account.ChangePasswordController">

    <left>
        <fx:include fx:id="menu" source="../menu-pane.fxml" />
    </left>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-viewport-fill: #EBF2F6;" styleClass="scroll-pane">
            <content>
                <VBox styleClass="main-pane" VBox.vgrow="ALWAYS">
                    <children>

                        <HBox alignment="CENTER_LEFT" prefHeight="71.0">
                            <children>
                                <Label style="-fx-text-fill: #218AD5; -fx-font-family: 'Instrument Sans'; -fx-font-weight: 700; -fx-font-size: 24px;" text="Change Password" />
                                <Region HBox.hgrow="ALWAYS" />
                            </children>
                            <VBox.margin><Insets bottom="10.0" top="50.0" /></VBox.margin>
                        </HBox>

                        <VBox alignment="CENTER" prefHeight="600.0" VBox.vgrow="ALWAYS">
                            <children>
                                <VBox maxWidth="450.0" spacing="25.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 35;" styleClass="dashboard-recent-card">
                                    <children>

                                        <VBox alignment="CENTER" spacing="12.0">
                                            <children>
                                                <ImageView fitHeight="64.0" fitWidth="64.0" preserveRatio="true">
                                                    <image><Image url="@../../../../images/Security.png" /></image>
                                                </ImageView>
                                                <Label style="-fx-font-family: 'Instrument Sans'; -fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Update Your Password" />
                                                <Label style="-fx-font-family: 'Instrument Sans'; -fx-text-fill: #64748B; -fx-text-alignment: center; -fx-font-size: 14px; -fx-font-weight: 500;" text="Please enter your current password to confirm it's you, then choose a new strong password." wrapText="true" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="18.0">
                                            <children>
                                                <VBox spacing="6.0">
                                                    <children>
                                                        <Label style="-fx-font-family: 'Instrument Sans'; -fx-font-weight: 600; -fx-text-fill: #1E293B;" text="Current Password" />
                                                        <PasswordField fx:id="currentPasswordField" prefHeight="45.0" promptText="Enter current password" styleClass="field-input" />
                                                    </children>
                                                </VBox>

                                                <Separator opacity="0.5" />

                                                <VBox spacing="6.0">
                                                    <children>
                                                        <Label style="-fx-font-family: 'Instrument Sans'; -fx-font-weight: 600; -fx-text-fill: #1E293B;" text="New Password" />
                                                        <PasswordField fx:id="newPasswordField" prefHeight="45.0" promptText="Minimum 6 characters" styleClass="field-input" />
                                                    </children>
                                                </VBox>

                                                <VBox spacing="6.0">
                                                    <children>
                                                        <Label style="-fx-font-family: 'Instrument Sans'; -fx-font-weight: 600; -fx-text-fill: #1E293B;" text="Confirm New Password" />
                                                        <PasswordField fx:id="confirmNewPasswordField" prefHeight="45.0" promptText="Repeat your new password" styleClass="field-input" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </VBox>

                                        <VBox spacing="12.0">
                                            <children>
                                                <Button fx:id="saveBtn" maxWidth="Infinity" prefHeight="45.0" style="-fx-font-family: 'Instrument Sans'; -fx-font-weight: 600;" styleClass="join-button" text="Save Changes" />
                                                <Button fx:id="cancelBtn" maxWidth="Infinity" onAction="#handleBack" prefHeight="40.0" style="-fx-background-color: transparent; -fx-text-fill: #64748B; -fx-font-family: 'Instrument Sans'; -fx-font-weight: 600; -fx-cursor: hand;" text="Cancel and Go Back" />
                                            </children>
                                            <VBox.margin><Insets top="10.0" /></VBox.margin>
                                        </VBox>

                                    </children>
                                </VBox>
                            </children>
                            <VBox.margin><Insets top="30.0" /></VBox.margin>
                        </VBox>

                    </children>
                    <padding>
                        <Insets bottom="40.0" left="40.0" right="40.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
