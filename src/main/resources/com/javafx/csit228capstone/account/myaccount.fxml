                              <VBox spacing="20.0" styleClass="main-pane">
                                  <children>
      
                                      <HBox alignment="CENTER" prefHeight="71.0">
                                          <children>
                                              <Label style="-fx-text-fill: #218AD5; -fx-font-family: 'Instrument Sans'; -fx-font-weight: 700; -fx-font-size: 24px;" styleClass="screen-label" text="My Account" />
                                              <Region maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS" />
                                              <Pane fx:id="notification" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="33.0" prefWidth="32.0" styleClass="dashboard-notification" />
                                          </children>
                                          <padding>
                                              <Insets left="5.0" right="5.0" top="50.0" />
                                          </padding>
                                      </HBox>
      
                                      <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="dashboard-recent-card">
                                          <children>
                                              <ImageView fx:id="profileImageView" fitHeight="80.0" fitWidth="80.0" preserveRatio="true">
                                                  <image>
                                          <Image url="@../../../../images/profile_icon.png" />
                                       </image>
                                              </ImageView>
                                              <VBox alignment="CENTER_LEFT" spacing="4.0" HBox.hgrow="ALWAYS">
                                                  <children>
                                                      <Label fx:id="profileNameLabel" style="-fx-font-family: 'Instrument Sans'; -fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="User Name" />
                                                      <Label fx:id="profileIdLabel" style="-fx-font-family: 'Instrument Sans'; -fx-text-fill: #64748B; -fx-font-size: 14px;" text="MS-26-00001" />
                                                  </children>
                                              </VBox>
                                              <Button fx:id="editBtn" mnemonicParsing="false" styleClass="join-button" text="Edit Profile" />
                                          </children>
                                          <padding>
                                    <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
