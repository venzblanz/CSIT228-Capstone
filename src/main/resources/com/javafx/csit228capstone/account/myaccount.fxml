                                    <Insets top="10.0" />
                                 </VBox.margin>
                                      </Label>
                                      <VBox styleClass="dashboard-recent-card">
                                          <children>
                                              <HBox fx:id="viewProfileRow" alignment="CENTER_LEFT" prefHeight="55.0" spacing="12.0" styleClass="menu-row">
                                                  <children>
                                                      <ImageView fitHeight="18.0" fitWidth="18.0" preserveRatio="true">
                                             <image>
                                                <Image url="@../../../../images/user.png" />
                                             </image>
                                          </ImageView>
                                                      <Label style="-fx-text-fill: #1E293B; -fx-font-family: 'Instrument Sans'; -fx-font-weight: 600; -fx-font-size: 15px;" text="View Profile Information" />
                                                      <Region HBox.hgrow="ALWAYS" />
                                          <ImageView fitHeight="14.0" fitWidth="14.0" preserveRatio="true">
                                             <image>
                                                <Image url="@../../../../images/arrow-acc.png" />
                                             </image>
                                          </ImageView>
                                                  </children>
                                                  <padding>
                                          <Insets left="16.0" right="16.0" />
                                       </padding>
                                              </HBox>
                                              <Separator />
                                              <HBox fx:id="queueHistoryRow" alignment="CENTER_LEFT" prefHeight="55.0" spacing="12.0" styleClass="menu-row">
                                                  <children>
                                                      <ImageView fitHeight="18.0" fitWidth="18.0" preserveRatio="true">
                                             <image>
                                                <Image url="@../../../../images/appointments.png" />
                                             </image>
                                          </ImageView>
                                                      <Label style="-fx-text-fill: #1E293B; -fx-font-family: 'Instrument Sans'; -fx-font-weight: 600; -fx-font-size: 15px;" text="View Queue History" />
                                                      <Region HBox.hgrow="ALWAYS" />
                                          <ImageView fitHeight="14.0" fitWidth="14.0" preserveRatio="true">
                                             <image>
                                                <Image url="@../../../../images/arrow-acc.png" />
                                             </image>
                                          </ImageView>
                                                  </children>
                                                  <padding>
                                          <Insets left="16.0" right="16.0" />
                                       </padding>
                                              </HBox>
                                              <Separator />
                                              <HBox fx:id="queueStatusRow" alignment="CENTER_LEFT" prefHeight="55.0" spacing="12.0" styleClass="menu-row">
