                                                      <ImageView fitHeight="18.0" fitWidth="18.0" preserveRatio="true">
                                             <image>
                                                <Image url="@../../../../images/queue-status.png" />
                                             </image>
                                          </ImageView>
                                                      <Label style="-fx-text-fill: #1E293B; -fx-font-family: 'Instrument Sans'; -fx-font-weight: 600; -fx-font-size: 15px;" text="Check Queue Status" />
                                                      <Region HBox.hgrow="ALWAYS" />
                                          <ImageView fitHeight="14.0" fitWidth="14.0" preserveRatio="true">
                                             <image>
                                                <Image url="@../../../../images/arrow-acc.png" />
                                             </image>
                                          </ImageView>
                                                  </children>
                                                  <padding>
                                          <Insets left="16.0" right="16.0" />
                                       </padding>
                                              </HBox>
                                          </children>
                                      </VBox>
      
                                      <Label style="-fx-font-family: 'Instrument Sans'; -fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #1E293B;" text="Settings &amp; Privacy">
                                          <VBox.margin>
                                    <Insets top="10.0" />
                                 </VBox.margin>
                                      </Label>
                                      <VBox styleClass="dashboard-recent-card">
                                          <children>
                                              <HBox fx:id="securityRow" alignment="CENTER_LEFT" prefHeight="55.0" spacing="12.0" styleClass="menu-row">
                                                  <children>
                                                      <ImageView fitHeight="18.0" fitWidth="18.0" preserveRatio="true">
                                             <image>
                                                <Image url="@../../../../images/Security.png" />
                                             </image>
                                          </ImageView>
                                                      <Label style="-fx-text-fill: #1E293B; -fx-font-family: 'Instrument Sans'; -fx-font-weight: 600; -fx-font-size: 15px;" text="Security &amp; Privacy" />
                                                      <Region HBox.hgrow="ALWAYS" />
                                          <ImageView fitHeight="14.0" fitWidth="14.0" preserveRatio="true">
                                             <image>
                                                <Image url="@../../../../images/arrow-acc.png" />
                                             </image>
                                          </ImageView>
                                                  </children>
                                                  <padding>
                                          <Insets left="16.0" right="16.0" />
                                       </padding>
                                              </HBox>
                                          </children>
                                      </VBox>
      
                                      <Label style="-fx-font-family: 'Instrument Sans'; -fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #1E293B;" text="Others">
                                          <VBox.margin>
                                    <Insets top="10.0" />
                                 </VBox.margin>
                                      </Label>
                                      <VBox styleClass="dashboard-recent-card">
                                          <children>
                                              <HBox fx:id="termsRow" alignment="CENTER_LEFT" prefHeight="55.0" spacing="12.0" styleClass="menu-row">
                                                  <children>
                                                      <ImageView fitHeight="18.0" fitWidth="18.0" preserveRatio="true">
                                             <image>
                                                <Image url="@../../../../images/terms.png" />
                                             </image>
                                          </ImageView>
                                                      <Label style="-fx-text-fill: #1E293B; -fx-font-family: 'Instrument Sans'; -fx-font-weight: 600; -fx-font-size: 15px;" text="Terms and Condition" />
                                                      <Region HBox.hgrow="ALWAYS" />
                                          <ImageView fitHeight="14.0" fitWidth="14.0" preserveRatio="true">
                                             <image>
                                                <Image url="@../../../../images/arrow-acc.png" />
                                             </image>
                                          </ImageView>
                                                  </children>
                                                  <padding>
                                          <Insets left="16.0" right="16.0" />
                                       </padding>
                                              </HBox>
                                              <Separator />
                                              <HBox fx:id="aboutRow" alignment="CENTER_LEFT" prefHeight="55.0" spacing="12.0" styleClass="menu-row">
                                                  <children>
                                                      <ImageView fitHeight="18.0" fitWidth="18.0" preserveRatio="true">
                                             <image>
                                                <Image url="@../../../../images/about.png" />
                                             </image>
                                          </ImageView>
                                                      <Label style="-fx-text-fill: #1E293B; -fx-font-family: 'Instrument Sans'; -fx-font-weight: 600; -fx-font-size: 15px;" text="About MedServe" />
                                                      <Region HBox.hgrow="ALWAYS" />
                                          <ImageView fitHeight="14.0" fitWidth="14.0" preserveRatio="true">
                                             <image>
                                                <Image url="@../../../../images/arrow-acc.png" />
                                             </image>
                                          </ImageView>
                                                  </children>
                                                  <padding>
                                          <Insets left="16.0" right="16.0" />
                                       </padding>
                                              </HBox>
                                          </children>
                                      </VBox>
      
                                      <VBox alignment="CENTER" prefHeight="100.0">
                                          <children>
                                              <Button fx:id="deleteAccountBtn" mnemonicParsing="false" prefHeight="45.0" prefWidth="350.0" style="-fx-background-color: transparent; -fx-text-fill: #D82F2F; -fx-border-color: #D82F2F; -fx-border-radius: 10; -fx-cursor: hand; -fx-font-family: 'Instrument Sans'; -fx-font-weight: 600;" text="Delete my account" />
                                          </children>
                                          <VBox.margin>
                                    <Insets bottom="40.0" top="20.0" />
                                 </VBox.margin>
                                      </VBox>
                                  </children>
                                  <padding>
                              <Insets bottom="30.0" left="35.0" right="35.0" />
