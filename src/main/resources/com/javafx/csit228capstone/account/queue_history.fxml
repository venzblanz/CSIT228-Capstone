<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javafx.csit228capstone.screens.Account.QueueHistoryController">

    <center>
            <VBox fx:id="historyScreen" prefHeight="700.0" prefWidth="473.0" style="-fx-background-color: EBF2F6;">
         <HBox prefHeight="37.0" prefWidth="460.0" styleClass="semi-b">
            <children>
                  <Label alignment="TOP_LEFT" text="Queue History">
                      <font>
                          <Font size="24.0" />
                      </font>
                  <HBox.margin>
                     <Insets />
                  </HBox.margin>
                  </Label>
            </children>
            <VBox.margin>
               <Insets top="30.0" />
            </VBox.margin>
         </HBox>
          <HBox alignment="CENTER_LEFT" prefHeight="25.0" styleClass="back-to-queuetype">
              <children>
                  <ImageView fx:id="backIconBtn" fitHeight="16.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true" styleClass="arrow-back">
                      <HBox.margin>
                          <Insets right="5.0" />
                      </HBox.margin>
                      <image>
                          <Image url="@../../../../images/arrow_blue.png" />
                      </image>
                  </ImageView>
                  <Label fx:id="backBtn" prefHeight="0.0" styleClass="back-to-queue" text="Back to My Account" />
              </children>
            <VBox.margin>
               <Insets top="10.0" />
            </VBox.margin>
          </HBox>
            <Separator layoutX="346.0" layoutY="109.0" prefHeight="4.0" prefWidth="482.0" style="-fx-background-color: #EBF2F6;">
            <VBox.margin>
               <Insets top="10.0" />
            </VBox.margin></Separator>
         <HBox alignment="CENTER" prefHeight="33.0" prefWidth="460.0" spacing="10.0" styleClass="section-card">
            <children>
               <VBox prefHeight="200.0" prefWidth="346.0" spacing="2.0" styleClass="semi-b">
                  <children>
                     <Label prefHeight="17.0" prefWidth="212.0" text="From" />
                     <DatePicker fx:id="dateFromFilter" prefHeight="29.0" prefWidth="282.0" promptText="Start Date" styleClass="date-picker" />
                  </children>
               </VBox>
               <VBox prefHeight="200.0" prefWidth="346.0" spacing="2.0" styleClass="semi-b">
                  <children>
                     <Label prefHeight="17.0" prefWidth="136.0" text="To" />
                     <DatePicker fx:id="dateToFilter" prefHeight="29.0" prefWidth="282.0" promptText="End Date" styleClass="date-picker" />
                  </children>
               </VBox>
               <Region prefHeight="200.0" prefWidth="200.0" />
               <VBox prefHeight="42.0" prefWidth="282.0" spacing="2.0" styleClass="semi-b">
                  <children>
                     <Label prefHeight="17.0" prefWidth="251.0" text="Status" />
                     <MenuButton fx:id="statusFilter" mnemonicParsing="false" prefHeight="25.0" prefWidth="185.0" styleClass="filter-menu" text="Select Status" textFill="#218ad5">
                       <items>
                           <CheckMenuItem fx:id="pendingStatus" mnemonicParsing="false" text="Waiting" />
                           <CheckMenuItem fx:id="completedStatus" mnemonicParsing="false" text="Completed" />
                           <CheckMenuItem fx:id="cancelledStatus" mnemonicParsing="false" text="Cancelled" />
                           <CheckMenuItem fx:id="allStatus" mnemonicParsing="false" text="All" />
                       </items>
                        <font>
                           <Font name="System" size="12.0" />
                        </font>
                     </MenuButton>
                  </children>
               </VBox>
               <Region prefHeight="200.0" prefWidth="200.0" />
               <VBox prefHeight="200.0" prefWidth="345.0" spacing="2.0" styleClass="semi-b">
                  <children>
                     <Label prefHeight="17.0" prefWidth="329.0" text="Department" />
                     <MenuButton fx:id="departmentFilter" mnemonicParsing="false" prefHeight="25.0" prefWidth="200.0" styleClass="filter-menu" text="Select Department" textFill="#218ad5">
                       <items>
                           <CheckMenuItem fx:id="genWellnessDept" mnemonicParsing="false" text="General Wellness" />
                           <CheckMenuItem fx:id="womenHealthDept" mnemonicParsing="false" text="Women's Health" />
                           <CheckMenuItem fx:id="specialFieldsDept" mnemonicParsing="false" text="Specialized Fields" />
                           <CheckMenuItem fx:id="diagnosticsLabDept" mnemonicParsing="false" text="Diagnostics and Laboratory" />
                           <CheckMenuItem fx:id="allDept" mnemonicParsing="false" text="All" />
                       </items>
                        <font>
                           <Font name="System" size="12.0" />
                        </font>
                     </MenuButton>
                  </children>
               </VBox>
               <Region prefHeight="200.0" prefWidth="200.0" />
               <VBox prefHeight="200.0" prefWidth="450.0" styleClass="semi-b">
                  <children>
                     <HBox prefHeight="100.0" prefWidth="600.0" VBox.vgrow="ALWAYS">
                        <children>
                           <Button fx:id="clearBtn" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#clearFilters" prefHeight="53.0" prefWidth="251.0" styleClass="btn-clear" text="CLEAR" textFill="WHITE" HBox.hgrow="ALWAYS">
                              <font>
                                 <Font name="System" size="15.0" />
                              </font>
                              <HBox.margin>
                                 <Insets right="15.0" />
                              </HBox.margin>
                           </Button>
                           <Button fx:id="loadHistoryBtn" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#loadHistory" prefHeight="53.0" prefWidth="300.0" styleClass="btn" text="APPLY" textFill="WHITE">
                              <font>
                                 <Font name="System" size="15.0" />
                              </font>
                           </Button>
                        </children>
                        <VBox.margin>
                           <Insets bottom="3.0" top="5.0" />
                        </VBox.margin>
                     </HBox>
                  </children>
               </VBox>
            </children>
            <VBox.margin>
               <Insets bottom="20.0" top="20.0" />
            </VBox.margin>
         </HBox>
            <TableView fx:id="queueTable" layoutX="347.0" layoutY="178.0" style="-fx-background-color: white;" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="dateColumn" editable="false" maxWidth="1.7976931348623157E308" minWidth="-1.0" prefWidth="135.0" resizable="false" text="DATE" />
                    <TableColumn fx:id="queueNumberColumn" editable="false" maxWidth="1.7976931348623157E308" minWidth="-1.0" prefWidth="73.0" resizable="false" text="QUEUE NO." />
               <TableColumn fx:id="departmentColumn" editable="false" maxWidth="1.7976931348623157E308" minWidth="-1.0" prefWidth="178.0" resizable="false" text="DEPARTMENT" />
                    <TableColumn fx:id="serviceColumn" editable="false" maxWidth="1.7976931348623157E308" minWidth="-1.0" prefWidth="243.0" resizable="false" text="PURPOSE" />
                    <TableColumn fx:id="statusColumn" editable="false" maxWidth="1.7976931348623157E308" minWidth="-1.0" prefWidth="137.0" resizable="false" text="STATUS" />
                    <TableColumn fx:id="staffColumn" editable="false" maxWidth="1.7976931348623157E308" minWidth="-1.0" prefWidth="270.0" resizable="false" text="STAFF" />
                </columns>
            <VBox.margin>
               <Insets />
            </VBox.margin>
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            </TableView>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
         </padding>
            </VBox>
        </center>
    <left>
        <VBox minWidth="300.0" prefWidth="200.0"> <!-- Match your sidebar's actual width -->
            <fx:include fx:id="menu" source="../menu-pane.fxml" />
        </VBox>
    </left>

</BorderPane>
