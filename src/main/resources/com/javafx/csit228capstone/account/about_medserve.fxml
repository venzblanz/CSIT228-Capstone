<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="1280.0" styleClass="main-pane" stylesheets="@../../../../styles/dashboard.css,@../../../../styles/account.css,@../../../../styles/menu-pane.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javafx.csit228capstone.screens.Account.AboutController">

    <left>
        <fx:include fx:id="menu" source="../menu-pane.fxml" />
    </left>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-viewport-fill: #EBF2F6;" styleClass="scroll-pane">
            <content>
                <VBox styleClass="main-pane" VBox.vgrow="ALWAYS">
                    <children>

                        <VBox alignment="CENTER_LEFT" spacing="5.0">
                            <children>
                                <HBox fx:id="backBtnRow" alignment="CENTER_LEFT" onMouseClicked="#handleBack" spacing="5.0" style="-fx-cursor: hand;">
                                    <children>
                                        <ImageView fitHeight="12.0" fitWidth="12.0" preserveRatio="true">
                                            <image><Image url="@../../../../images/arrow_blue.png" /></image>
                                        </ImageView>
                                        <Label style="-fx-text-fill: #218AD5; -fx-font-family: 'Instrument Sans'; -fx-font-weight: 600; -fx-font-size: 13px;" text="Back to My Account" />
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label style="-fx-text-fill: #218AD5; -fx-font-family: 'Instrument Sans'; -fx-font-weight: 700; -fx-font-size: 24px;" text="About MedServe" />
                                        <Region HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>
                            </children>
                            <VBox.margin><Insets bottom="20.0" top="50.0" /></VBox.margin>
                        </VBox>

                        <VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 40;" styleClass="dashboard-recent-card">
                            <children>
                                <ImageView fitHeight="100.0" fitWidth="100.0" preserveRatio="true">
                                    <image><Image url="@../../../../images/medserveLogo.png" /></image>
                                </ImageView>
                                <Label style="-fx-font-family: 'Instrument Sans'; -fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Your Partner in Organized Healthcare" />
                                <Label maxWidth="700.0" style="-fx-font-family: 'Instrument Sans'; -fx-text-fill: #64748B; -fx-text-alignment: center; -fx-font-size: 15px; -fx-line-spacing: 5; -fx-font-weight: 500;" text="MedServe streamlines access to essential services by addressing long waiting times and missed updates. We integrate online queuing, doctor availability, and real-time notifications into a single platform for a smoother experience." wrapText="true" />
                            </children>
                        </VBox>

                        <Label style="-fx-font-family: 'Instrument Sans'; -fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #1E293B;" text="What we offer">
                            <VBox.margin><Insets bottom="10.0" top="25.0" /></VBox.margin>
                        </Label>

                        <VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 12;" styleClass="dashboard-recent-card">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <ImageView fitHeight="32.0" fitWidth="32.0"><image><Image url="@../../../../images/queue-status.png" /></image></ImageView>
                                    <VBox>
                                        <Label style="-fx-font-family: 'Instrument Sans'; -fx-font-weight: bold; -fx-text-fill: #1E293B; -fx-font-size: 15px;" text="Real-Time Queuing" />
                                        <Label style="-fx-font-family: 'Instrument Sans'; -fx-text-fill: #64748B; -fx-font-size: 14px; -fx-font-weight: 500;" text="Join queues from home and monitor your position live, reducing on-site waiting." />
                                    </VBox>
                                </HBox>

                                <Separator />

                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <ImageView fitHeight="32.0" fitWidth="32.0"><image><Image url="@../../../../images/calendar.png" /></image></ImageView>
                                    <VBox>
                                        <Label style="-fx-font-family: 'Instrument Sans'; -fx-font-weight: bold; -fx-text-fill: #1E293B; -fx-font-size: 15px;" text="Efficient Scheduling" />
                                        <Label style="-fx-font-family: 'Instrument Sans'; -fx-text-fill: #64748B; -fx-font-size: 14px; -fx-font-weight: 500;" text="View doctor availability and service schedules to plan your visit effectively." />
                                    </VBox>
                                </HBox>

                                <Separator />

                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <ImageView fitHeight="32.0" fitWidth="32.0"><image><Image url="@../../../../images/notification_icon.png" /></image></ImageView>
                                    <VBox>
                                        <Label style="-fx-font-family: 'Instrument Sans'; -fx-font-weight: bold; -fx-text-fill: #1E293B; -fx-font-size: 15px;" text="Smart Notifications" />
                                        <Label style="-fx-font-family: 'Instrument Sans'; -fx-text-fill: #64748B; -fx-font-size: 14px; -fx-font-weight: 500;" text="Get alerted for upcoming appointments and important health center announcements." />
                                    </VBox>
                                </HBox>
                            </children>
                            <padding><Insets bottom="25.0" left="25.0" right="25.0" top="25.0" /></padding>
                        </VBox>

                        <VBox alignment="CENTER" spacing="5.0">
                            <children>
                                <Label style="-fx-font-family: 'Instrument Sans'; -fx-text-fill: #94A3B8; -fx-font-size: 12px; -fx-font-weight: 500;" text="MedServe Version 1.0.0" />
                                <Label style="-fx-font-family: 'Instrument Sans'; -fx-text-fill: #94A3B8; -fx-font-size: 12px; -fx-font-weight: 500;" text="© 2026 CIT-University Capstone Project" />
                            </children>
                            <VBox.margin><Insets bottom="30.0" top="40.0" /></VBox.margin>
                        </VBox>

                    </children>
                    <padding>
                        <Insets bottom="20.0" left="40.0" right="40.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
