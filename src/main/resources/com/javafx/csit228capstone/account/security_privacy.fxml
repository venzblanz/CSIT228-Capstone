<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="800.0" prefWidth="1280.0"
            stylesheets="@../../../../styles/account.css,@../../../../styles/menu-pane.css"
            xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.javafx.csit228capstone.screens.Account.SecurityController">
    <left>
        <fx:include fx:id="menu" source="../menu-pane.fxml" />
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #F8FAFC;">
            <content>
                <VBox styleClass="main-content">
                    <children>
                        <HBox alignment="CENTER_LEFT" styleClass="top-bar">
                            <children>
                                <Label style="-fx-font-family: 'Segoe UI'; -fx-font-size: 24px; -fx-font-weight: normal; -fx-text-fill: #1E293B;"
                                       text="Security &amp; Privacy" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button fx:id="notifBtn" mnemonicParsing="false" styleClass="notif-btn">
                                    <graphic>
                                        <ImageView fitHeight="24.0" fitWidth="24.0" preserveRatio="true">
                                            <image><Image url="@../../../../images/notification_icon.png" /></image>
                                        </ImageView>
                                    </graphic>
                                </Button>
                            </children>
                            <VBox.margin><Insets top="30.0" /></VBox.margin>
                        </HBox>

                        <Button fx:id="backBtn" mnemonicParsing="false" onAction="#handleBack"
                                style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0;"
                                text=" Go Back" textFill="#64748B">
                            <graphic>
                                <ImageView fitHeight="16.0" fitWidth="16.0" preserveRatio="true">
                                    <image>
                                         <Image url="@../../../../images/arrow_blue.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                            <VBox.margin><Insets top="15.0" /></VBox.margin>
                            <font>
                                <javafx.scene.text.Font name="Segoe UI" size="14.0" />
                            </font>
                        </Button>


                        <Label styleClass="section-title" text="Account Security">
                            <VBox.margin><Insets bottom="8.0" top="20.0" /></VBox.margin>
                        </Label>

                        <VBox styleClass="section-card">
                            <children>

                                <HBox fx:id="changePasswordRow" onMouseClicked="#handleChangePassword"
                                      alignment="CENTER_LEFT" prefHeight="50.0" spacing="12.0" styleClass="menu-row">
                                    <children>
                                        <ImageView fitHeight="18.0" fitWidth="18.0" preserveRatio="true">
                                            <image><Image url="@../../../../images/Security.png" /></image>
                                        </ImageView>
                                        <Label styleClass="menu-row-label" text="Change Password" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <ImageView fitHeight="14.0" fitWidth="14.0" preserveRatio="true" styleClass="arrow-icon">
                                            <image><Image url="@../../../../images/arrow-acc.png" /></image>
                                        </ImageView>
                                    </children>
                                    <padding><Insets left="16.0" right="16.0" /></padding>
                                </HBox>

                                <Separator styleClass="row-separator" />
                                <HBox fx:id="clearCacheRow" onMouseClicked="#handleClearCache"
                                      alignment="CENTER_LEFT" prefHeight="50.0" spacing="12.0" styleClass="menu-row">
                                    <children>
                                        <ImageView fitHeight="18.0" fitWidth="18.0" preserveRatio="true">
                                            <image><Image url="@../../../../images/trash.png" /></image>
                                        </ImageView>
                                        <Label styleClass="menu-row-label" text="Clear Local Data" />
                                        <Region HBox.hgrow="ALWAYS" />
                                    </children>
                                    <padding><Insets left="16.0" right="16.0" /></padding>
                                </HBox>
                            </children>
                        </VBox>

                        <Label styleClass="section-title" text="Legal &amp; Policies">
                            <VBox.margin><Insets bottom="8.0" top="25.0" /></VBox.margin>
                        </Label>

                        <VBox styleClass="section-card">
                            <children>
                                <HBox fx:id="privacyPolicyRow" onMouseClicked="#handlePrivacyPolicy"
                                      alignment="CENTER_LEFT" prefHeight="50.0" spacing="12.0" styleClass="menu-row">
                                    <children>
                                        <ImageView fitHeight="18.0" fitWidth="18.0" preserveRatio="true">
                                            <image><Image url="@../../../../images/terms.png" /></image>
                                        </ImageView>
                                        <Label styleClass="menu-row-label" text="Privacy Policy" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <ImageView fitHeight="14.0" fitWidth="14.0" preserveRatio="true" styleClass="arrow-icon">
                                            <image><Image url="@../../../../images/arrow-acc.png" /></image>
                                        </ImageView>
                                    </children>
                                    <padding><Insets left="16.0" right="16.0" /></padding>
                                </HBox>
                            </children>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS" />

                    </children>
                    <padding>
                        <Insets bottom="40.0" left="20.0" right="20.0" top="10.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>