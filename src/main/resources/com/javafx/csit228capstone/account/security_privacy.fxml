<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="800.0" prefWidth="1280.0" styleClass="main-pane" stylesheets="@../../../../styles/account.css,@../../../../styles/menu-pane.css,@../../../../styles/dashboard.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javafx.csit228capstone.screens.Account.SecurityController">
    <left>
        <fx:include fx:id="menu" source="../menu-pane.fxml" />
    </left>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-viewport-fill: #EBF2F6;" styleClass="scroll-pane">
            <content>
                <VBox styleClass="main-pane" VBox.vgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" prefHeight="71.0">
                            <children>
                                <Label text="Security &amp; Privacy" style="-fx-text-fill: #218AD5; -fx-font-family: 'Instrument Sans'; -fx-font-weight: 700; -fx-font-size: 24px;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Pane fx:id="notification" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="33.0" prefWidth="32.0" styleClass="dashboard-notification" />
                            </children>
                            <VBox.margin><Insets bottom="10.0" top="50.0" /></VBox.margin>
                        </HBox>

                        <Button fx:id="backBtn" mnemonicParsing="false" onAction="#handleBack"
                                style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0;"
                                text=" Go Back">
                            <graphic>
                                <ImageView fitHeight="14.0" fitWidth="14.0" preserveRatio="true">
                                    <image>
                                        <Image url="@../../../../images/arrow_blue.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                            <VBox.margin><Insets bottom="15.0" top="5.0" /></VBox.margin>
                            <font>
                                <Font name="Instrument Sans SemiBold" size="14.0" />
                            </font>
                            <style>-fx-text-fill: #218AD5; -fx-font-family: 'Instrument Sans'; -fx-font-weight: 600;</style>
                        </Button>

                        <Label text="Account Security" style="-fx-font-family: 'Instrument Sans'; -fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #1E293B;">
                            <VBox.margin><Insets bottom="10.0" top="10.0" /></VBox.margin>
                        </Label>

                        <VBox styleClass="dashboard-recent-card" style="-fx-background-color: white; -fx-background-radius: 12;">
                            <children>
                                <HBox fx:id="changePasswordRow" onMouseClicked="#handleChangePassword"
                                      alignment="CENTER_LEFT" prefHeight="55.0" spacing="12.0" styleClass="menu-row">
                                    <children>
                                        <ImageView fitHeight="18.0" fitWidth="18.0" preserveRatio="true">
                                            <image><Image url="@../../../../images/Security.png" /></image>
                                        </ImageView>
                                        <Label text="Change Password" style="-fx-text-fill: #1E293B; -fx-font-family: 'Instrument Sans'; -fx-font-weight: 600; -fx-font-size: 15px;" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <ImageView fitHeight="14.0" fitWidth="14.0" preserveRatio="true">
                                            <image><Image url="@../../../../images/arrow-acc.png" /></image>
                                        </ImageView>
                                    </children>
                                    <padding><Insets left="16.0" right="16.0" /></padding>
                                </HBox>

                                <Separator />

                                <HBox fx:id="clearCacheRow" onMouseClicked="#handleClearCache"
                                      alignment="CENTER_LEFT" prefHeight="55.0" spacing="12.0" styleClass="menu-row">
                                    <children>
                                        <ImageView fitHeight="18.0" fitWidth="18.0" preserveRatio="true">
                                            <image><Image url="@../../../../images/trash.png" /></image>
                                        </ImageView>
                                        <Label text="Clear Local Data" style="-fx-text-fill: #1E293B; -fx-font-family: 'Instrument Sans'; -fx-font-weight: 600; -fx-font-size: 15px;" />
                                        <Region HBox.hgrow="ALWAYS" />
                                    </children>
                                    <padding><Insets left="16.0" right="16.0" /></padding>
                                </HBox>
                            </children>
                        </VBox>

<!--                        <Label text="Legal &amp; Policies" style="-fx-font-family: 'Instrument Sans'; -fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #1E293B;">-->
<!--                            <VBox.margin><Insets bottom="10.0" top="25.0" /></VBox.margin>-->
<!--                        </Label>-->

<!--                        <VBox styleClass="dashboard-recent-card" style="-fx-background-color: white; -fx-background-radius: 12;">-->
<!--                            <children>-->
<!--                                <HBox fx:id="privacyPolicyRow" onMouseClicked="#handlePrivacyPolicy"-->
<!--                                      alignment="CENTER_LEFT" prefHeight="55.0" spacing="12.0" styleClass="menu-row">-->
<!--                                    <children>-->
<!--                                        <ImageView fitHeight="18.0" fitWidth="18.0" preserveRatio="true">-->
<!--                                            <image><Image url="@../../../../images/terms.png" /></image>-->
<!--                                        </ImageView>-->
<!--                                        <Label text="Privacy Policy" style="-fx-text-fill: #1E293B; -fx-font-family: 'Instrument Sans'; -fx-font-weight: 600; -fx-font-size: 15px;" />-->
<!--                                        <Region HBox.hgrow="ALWAYS" />-->
<!--                                        <ImageView fitHeight="14.0" fitWidth="14.0" preserveRatio="true">-->
<!--                                            <image><Image url="@../../../../images/arrow-acc.png" /></image>-->
<!--                                        </ImageView>-->
<!--                                    </children>-->
<!--                                    <padding><Insets left="16.0" right="16.0" /></padding>-->
<!--                                </HBox>-->
<!--                            </children>-->
<!--                        </VBox>-->

                        <Region VBox.vgrow="ALWAYS" />
                    </children>
                    <padding>
                        <Insets bottom="40.0" left="40.0" right="40.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>