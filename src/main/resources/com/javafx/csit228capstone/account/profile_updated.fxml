<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>


<StackPane fx:id="profileRoot" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javafx.csit228capstone.screens.Account.ProfileUpdatedController">
   <children>
      <BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="1280.0" styleClass="main-pane" stylesheets="@../../../../styles/dashboard.css,@../../../../styles/account-edit.css,@../../../../styles/menu-pane.css">
      
          <left>
              <fx:include fx:id="menu" source="../menu-pane.fxml" />
          </left>
      
          <center>
              <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-viewport-fill: #EBF2F6;" styleClass="scroll-pane">
                  <content>
                      <VBox styleClass="main-pane" VBox.vgrow="ALWAYS">
                          <children>
                              <HBox alignment="CENTER_LEFT" prefHeight="71.0">
                                  <children>
                                      <Label style="-fx-font-family: 'Instrument Sans'; -fx-font-weight: 700; -fx-font-size: 24px;" styleClass="screen-label" text="My Account" />
                                      <Region HBox.hgrow="ALWAYS" />
                                      <Pane fx:id="notification" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="33.0" prefWidth="32.0" styleClass="dashboard-notification" />
                                  </children>
                                  <VBox.margin>
                              <Insets bottom="10.0" top="50.0" />
                           </VBox.margin>
                              </HBox>
      
                              <VBox alignment="CENTER" prefHeight="550.0" VBox.vgrow="ALWAYS">
                                  <children>
                                      <VBox alignment="CENTER" maxWidth="450.0" spacing="30.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 40;" styleClass="dashboard-recent-card">
                                          <children>
                                              <VBox alignment="CENTER" spacing="15.0">
                                                  <children>
                                                      <ImageView fitHeight="80.0" fitWidth="80.0" preserveRatio="true">
                                                          <image>
                                                              <Image url="@../../../../images/success.png" />
                                                          </image>
                                                      </ImageView>
                                                      <Label style="-fx-font-family: 'Instrument Sans'; -fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1E293B;" text="Profile Updated!" />
                                                      <Label style="-fx-font-family: 'Instrument Sans'; -fx-text-fill: #64748B; -fx-text-alignment: center; -fx-font-size: 15px; -fx-font-weight: 500;" text="Your account information has been successfully updated." wrapText="true" />
                                                  </children>
                                              </VBox>
      
                                              <Button fx:id="continueBtn" mnemonicParsing="false" onAction="#handleContinue" prefHeight="45.0" prefWidth="250.0" style="-fx-font-family: 'Instrument Sans'; -fx-font-weight: 600;" styleClass="join-button" text="Continue" />
                                          </children>
                                      </VBox>
                                  </children>
                                  <VBox.margin>
                                      <Insets top="40.0" />
                                  </VBox.margin>
                              </VBox>
                          </children>
                          <padding>
                              <Insets bottom="20.0" left="40.0" right="40.0" />
                          </padding>
                      </VBox>
                  </content>
              </ScrollPane>
          </center>
      </BorderPane>
   </children>
</StackPane>
